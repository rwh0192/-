    <script>
        // --- 1. 환영 인사 기능 ---
        function greetVisitor() {
            const name = document.getElementById('visitor-name').value.trim();
            const msgBox = document.getElementById('greeting-msg');
            if(name === "") {
                msgBox.innerText = "이름을 입력해야 퀘스트를 시작할 수 있습니다.";
                msgBox.style.color = "var(--neon-pink)";
            } else {
                msgBox.innerHTML = `> 환영합니다, 용사 [ <span style="color:#fff">${name}</span> ]님!<br>> 노O현의 세계에 로그인하셨습니다.`;
                msgBox.style.color = "var(--neon-green)";
            }
        }

        // --- 3. OX 퀴즈 기능 ---
        function checkQuiz(answer) {
            const resultBox = document.getElementById('quiz-result');
            
            // 기존 애니메이션 클래스 제거
            resultBox.classList.remove('success-anim', 'fail-anim');
            void resultBox.offsetWidth; // 리플로우 강제 발생 (애니메이션 재시작을 위해)

            if (answer === 'O') {
                resultBox.innerText = "SUCCESS! 정답입니다! 누가 저 좀 집 좀 보내주셈";
                resultBox.classList.add('success-anim');
            } else {
                resultBox.innerText = "GAME OVER! 오답입니다. 겠냐고요";
                resultBox.classList.add('fail-anim');
            }
        }

        // --- 4. 오늘의 운세 기능 ---
        const fortunes = [
            "오늘 밤엔 꿀잠을 자게 될 확률 99.9%",
            "가다 서다 반복하다 길에서 만원짜리를 주울 지도?",
            "오늘 저녁 메뉴 선택은 대성공! 미각이 춤을 춥니다.",
            "예상치 못한 곳에서 반가운 연락이 옵니다. (스팸 아님)",
            "게임에서 원하던 아이템을 득템할 운세입니다. 가챠 고고!",
            "오늘은 뭘 해도 귀찮은 날. 그냥 누워있는 게 최고입니다.",
            "와이파이가 빵빵하게 터지는 하루! 로딩 스트레스 제로.",
            "누군가 당신에게 작지만 확실한 칭찬을 해줄 것입니다.",
            "방 정리를 하다 잃어버린 줄 알았던 비상금을 발견합니다!",
            "오늘은 뭘 해도 평타 이상 치는 운수 좋은 날!",
            "커피나 음료수를 무료로 얻어마실 기회가 생깁니다.",
            "집에 돌아가는 길이 평소보다 빠르고 쾌적하게 느껴질 것입니다."
        ];

        function drawFortune() {
            const fortuneBox = document.getElementById('fortune-text');
            // 섞는 효과를 위한 짧은 딜레이 애니메이션
            let count = 0;
            const shuffle = setInterval(() => {
                fortuneBox.innerText = fortunes[Math.floor(Math.random() * fortunes.length)];
                count++;
                if (count > 10) {
                    clearInterval(shuffle);
                    const finalIdx = Math.floor(Math.random() * fortunes.length);
