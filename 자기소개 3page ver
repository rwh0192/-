    <title>노O현의 8비트 자기소개</title>
    <style>
        /* 레트로 픽셀 폰트 불러오기 */
        @font-face {
            font-family: 'DungGeunMo';
            src: url('https://fastly.jsdelivr.net/gh/projectnoonnu/noonfonts_six@1.2/DungGeunMo.woff') format('woff');
            font-weight: normal;
            font-style: normal;
        }

        :root {
            --bg-color: #111;
            --text-color: #fff;
            --neon-green: #39ff14;
            --neon-pink: #ff007f;
            --neon-yellow: #fdfd96;
            --neon-blue: #0ff;
            --border-style: 4px solid var(--text-color);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'DungGeunMo', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: hidden;
        }

        h1, h2, h3 {
            text-align: center;
            text-transform: uppercase;
            margin-bottom: 15px;
            letter-spacing: 2px;
        }

        .container {
            width: 100%;
            max-width: 600px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .section {
            border: var(--border-style);
            padding: 20px;
            background: #000;
            box-shadow: 8px 8px 0px rgba(255, 255, 255, 0.2);
            position: relative;
        }

        .section::before {
            content: '';
            position: absolute;
            top: 2px; left: 2px; right: 2px; bottom: 2px;
            border: 2px dashed #444;
            pointer-events: none;
        }

        /* 깜빡이는 효과 */
        .blink {
            animation: blinker 1s linear infinite;
        }
        @keyframes blinker {
            50% { opacity: 0; }
        }

        /* 공통 버튼 스타일 */
        button {
            background-color: transparent;
            color: var(--neon-green);
            border: 2px solid var(--neon-green);
            padding: 10px 15px;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            text-transform: uppercase;
        }
        button:hover {
            background-color: var(--neon-green);
            color: #000;
        }
        button:active {
            transform: translate(2px, 2px);
        }
        button:disabled {
            border-color: #555;
            color: #555;
            cursor: not-allowed;
            background: transparent;
        }

        /* 텍스트 입력창 */
        input[type="text"] {
            background: #000;
            border: 2px solid var(--neon-blue);
            color: var(--neon-blue);
            padding: 10px;
            font-size: 1rem;
            width: calc(100% - 100px);
            margin-right: 5px;
        }
        input[type="text"]:focus {
            outline: none;
            box-shadow: 0 0 5px var(--neon-blue);
        }

        /* 1. 환영 인사 */
        .greeting-area {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 10px;
        }
        .greeting-area input { flex-grow: 1; min-width: 150px; }
        #greeting-msg {
            color: var(--neon-yellow);
            min-height: 24px;
            margin-top: 10px;
        }

        /* 2. 좋아하는 것 (플립 카드) */
        .cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }
        .card {
            background-color: transparent;
            width: 100%;
            height: 120px;
            perspective: 1000px;
            cursor: pointer;
        }
        .card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.6s;
            transform-style: preserve-3d;
        }
        .card.is-flipped .card-inner {
            transform: rotateY(180deg);
        }
        .card-front, .card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--text-color);
            padding: 10px;
            font-size: 1.1rem;
        }
        .card-front {
            background-color: #222;
            color: var(--text-color);
        }
        .card-back {
            background-color: var(--neon-pink);
            color: #fff;
            transform: rotateY(180deg);
            font-size: 0.9rem;
            border-color: var(--neon-pink);
        }

        /* 3. OX 퀴즈 */
        .quiz-buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
        }
        .btn-o { border-color: var(--neon-blue); color: var(--neon-blue); font-size: 1.5rem; width: 60px; height: 60px;}
        .btn-o:hover { background-color: var(--neon-blue); color: #000; }
        .btn-x { border-color: var(--neon-pink); color: var(--neon-pink); font-size: 1.5rem; width: 60px; height: 60px;}
        .btn-x:hover { background-color: var(--neon-pink); color: #000; }
        
        #quiz-result {
            margin-top: 15px;
            text-align: center;
            min-height: 24px;
            transition: all 0.3s;
        }
        /* 정답/오답 애니메이션 */
        .success-anim { animation: successFlash 0.5s 3; color: var(--neon-yellow); }
        .fail-anim { animation: shake 0.5s; color: var(--neon-pink); }
        
        @keyframes successFlash {
            0%, 100% { background-color: transparent; }
            50% { background-color: var(--neon-green); color: #000; }
        }
        @keyframes shake {
            0% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            50% { transform: translateX(10px); }
            75% { transform: translateX(-10px); }
            100% { transform: translateX(0); }
        }

        /* 4. 오늘의 운세 */
        .fortune-section { text-align: center; }
        #fortune-text {
            margin-top: 20px;
            padding: 15px;
            border: 2px dotted var(--neon-yellow);
            color: var(--neon-yellow);
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            word-break: keep-all;
        }

        /* 5. 미니게임 */
        .minigame-section { text-align: center; }
        .stats {
            display: flex;
            justify-content: space-around;
            margin: 15px 0;
            font-size: 1.2rem;
            color: var(--neon-blue);
        }
        #btn-mash {
            width: 100%;
            height: 80px;
            font-size: 1.5rem;
            margin-top: 10px;
            border-style: dashed;
        }
        
        .game-title {
            color: var(--neon-pink);
            text-shadow: 2px 2px #000;
        }

    </style>
